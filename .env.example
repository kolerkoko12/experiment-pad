# Server-only. Never prefix with VITE_ and never put these in client JS.
# Netlify: Site settings → Environment variables (or `netlify env:set`).
COMFY_CLOUD_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org
# Force checkpoint for every job (wins over brain map).
COMFY_CHECKPOINT=
# Optional per-family filenames as they appear in Comfy Cloud (if you rename files).
COMFY_CHECKPOINT_ILLUSTRIOUS=Illustrious-XL-sdxl.safetensors
COMFY_CHECKPOINT_SDXL=realvisxlV50_v50Bakedvae.safetensors
COMFY_CHECKPOINT_FLUX=flux1-dev-fp8.safetensors
